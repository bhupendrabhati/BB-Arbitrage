APP_ENV=development
APP_NAME=BB-ARBITRAGE
DEBUG=true

# Database
POSTGRES_USER=bbuser
POSTGRES_PASSWORD=bbpass
POSTGRES_DB=bb_arbitrage
DATABASE_URL=postgresql+asyncpg://bbuser:bbpass@postgres:5432/bb_arbitrage

# Redis
REDIS_URL=redis://redis:6379/0

# Trading Mode: scanner | paper | live
TRADING_MODE=paper

# Capital Protection (INR)
INITIAL_CAPITAL_INR=100
MAX_TRADE_AMOUNT_INR=10
MAX_DAILY_LOSS_INR=2
MAX_OPEN_TRADES=1
MAX_TRADES_PER_DAY=5

# Profit Thresholds
MIN_NET_PROFIT_INR=0.10
MIN_NET_PROFIT_PERCENT=0.01

# Slippage
MAX_SLIPPAGE_PERCENT=0.05

# Market Data
STALE_DATA_MS=500

# Live Trading (DISABLED BY DEFAULT)
LIVE_TRADING_ENABLED=false

# Exchange Keys (NEVER commit these)
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Security
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=false
